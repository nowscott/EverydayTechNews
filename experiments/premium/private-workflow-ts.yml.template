name: Internal premium pool (TypeScript, private data only)
on:
  workflow_dispatch:
    inputs:
      maintenance_only:
        description: 'Restore, collect and archive only; no model or SMTP'
        type: boolean
        default: true
      verify_api:
        description: 'Single-article TS API verification; no mail'
        type: boolean
        default: false
      verify_quality:
        description: 'Bounded AI quality acceptance, synthetic pairs only; no SMTP'
        type: boolean
        default: false
      fresh_sample:
        description: 'One frozen current-24h TS launch sample to the allowlisted inbox'
        type: boolean
        default: false
      sample_revision:
        description: 'Keep each authorized sample immutable; serif is the requested revised sample'
        type: choice
        options: [initial, serif, serif-retry, makeup]
        default: initial
  schedule:
    # UTC equivalents of Shanghai 04:07 / recovery 04:37,05:07,06:37,07:37,08:37.
    - cron: '7 20,21 * * *'
    - cron: '37 20,22,23,0 * * *'
    # Maintenance deliberately stays outside Shanghai 04:00–09:00.
    - cron: '15 1-19 * * *'
permissions:
  contents: write
  actions: write
  issues: write
concurrency:
  group: premium-private-state
  cancel-in-progress: false
jobs:
  pool:
    if: github.repository == 'nowscott/EverydayTechNews-data' && github.event.repository.private == true && (vars.PREMIUM_ENABLED == 'true' || (github.event_name == 'workflow_dispatch' && (inputs.maintenance_only || inputs.verify_api || inputs.verify_quality || inputs.fresh_sample)))
    runs-on: ubuntu-latest
    timeout-minutes: 350
    env:
      GH_TOKEN: ${{ github.token }}
    steps:
      - uses: actions/checkout@v5
        with:
          path: state
          persist-credentials: true
      - uses: actions/checkout@v5
        with:
          repository: nowscott/EverydayTechNews
          ref: __ENGINE_SHA__
          path: engine
          persist-credentials: false
      - uses: actions/setup-node@v6
        with:
          node-version: '24'
          cache: npm
          cache-dependency-path: engine/packages/news-engine/package-lock.json
      - name: Install locked runtime dependencies
        run: npm ci --prefix engine/packages/news-engine --omit=dev --ignore-scripts --no-audit --no-fund
      - name: Expose artifact runtime to staged archive uploader
        uses: actions/github-script@v8
        with:
          script: |
            for (const key of ['ACTIONS_RUNTIME_TOKEN', 'ACTIONS_RESULTS_URL', 'ACTIONS_RUNTIME_URL']) {
              if (!process.env[key]) throw new Error('Missing artifact runtime ' + key);
              if (key === 'ACTIONS_RUNTIME_TOKEN') core.setSecret(process.env[key]);
              core.exportVariable(key, process.env[key]);
            }
      - name: Configure private state author
        working-directory: state
        run: |
          git config user.name 'github-actions[bot]'
          git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
      - name: TypeScript restore, maintenance and due tasks
        id: engine
        env:
          NOTION_API_KEY: ${{ secrets.NOTION_API_KEY }}
          NOTION_DATABASE_ID: ${{ secrets.NOTION_DATABASE_ID }}
          NOTION_DATA_SOURCE_ID: ${{ secrets.NOTION_DATA_SOURCE_ID }}
          DEEPSEEK_API_KEY: ${{ secrets.DEEPSEEK_API_KEY }}
          SENDING_ACCOUNT: ${{ secrets.PREMIUM_SMTP_ACCOUNT }}
          SENDING_PASSWORD: ${{ secrets.PREMIUM_SMTP_PASSWORD }}
          SERVER: ${{ secrets.PREMIUM_SMTP_SERVER }}
          MAINTENANCE: ${{ github.event_name == 'workflow_dispatch' && inputs.maintenance_only }}
          LAUNCH: ${{ github.event_name == 'workflow_dispatch' && inputs.fresh_sample }}
          SAMPLE_REVISION: ${{ inputs.sample_revision || 'initial' }}
          VERIFY_QUALITY: ${{ github.event_name == 'workflow_dispatch' && inputs.verify_quality }}
          VERIFY_API: ${{ github.event_name == 'workflow_dispatch' && inputs.verify_api }}
        run: >-
          node engine/packages/news-engine/src/main.ts run --data state --sync-git
          --maintenance-only "$MAINTENANCE" --launch "$LAUNCH" --verify-api "$VERIFY_API" --verify-quality "$VERIFY_QUALITY" --sample-revision "$SAMPLE_REVISION"
      - name: Store fulltext and raw responses for 90 days
        id: archive
        if: always() && steps.engine.outputs.archive_ready == 'true'
        uses: actions/upload-artifact@v7
        with:
          name: ${{ steps.engine.outputs.artifact_name }}
          path: state/.cache/evidence.tar.gz
          retention-days: 90
          if-no-files-found: error
      - name: Confirm uploaded archive and prune superseded daily buckets
        if: always() && steps.archive.outcome == 'success'
        run: node engine/packages/news-engine/src/main.ts ack-artifact --data state --sync-git
